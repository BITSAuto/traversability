Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Alpha: 0.4
    - Class: rviz_default_plugins/Map
      Name: Traversability grid
      Enabled: true
      Topic:
        Value: /traversability/grid
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.8
      Draw Behind: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Labelled points (0 unknown, 1 ground, 2 obstacle, 3 drop, 4 overhead)
      Enabled: true
      Topic:
        Value: /traversability/ground_points
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Transformer: Intensity
      Channel Name: label
      Use rainbow: true
      Invert Rainbow: false
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 4
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/Image
      Name: Colour
      Enabled: true
      Topic:
        Value: /camera/camera/color/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: camera_ground
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Focal Point:
        X: 3
        Y: 0
        Z: 0
      Distance: 10
      Pitch: 0.9
      Yaw: 3.14
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1400
  Height: 900
